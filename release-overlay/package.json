{
  "name": "snap-ebt-grocery-tracker",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "embed:web": "node scripts/embed-web-app.mjs app.html src/appHtml.ts",
    "verify:release": "node scripts/verify-test-release.mjs",
    "validate": "npm run embed:web && npm run typecheck && npm run verify:release"
  },
  "dependencies": {
    "expo": "~57.0.9",
    "expo-build-properties": "~57.0.8",
    "expo-file-system": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-google-mobile-ads": "16.4.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
